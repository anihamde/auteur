{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "extends": ["./packages/biome-config/base.json"],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**/*",
      "packages/**/*",
      "scripts/**/*",
      "package.json",
      "biome.json",
      "turbo.json",
      "!**/.turbo/**/*",
      "!**/dist/**/*",
      "!**/.vercel/**/*",
      "!**/coverage/**/*",
      "!**/node_modules/**/*",
      "!**/styled-system/**/*",
      "!**/src/generated/**/*",
      "!**/*.tsbuildinfo",
      "!**/api-surface.md",
      "!docs/design/**/*"
    ]
  }
}
