{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/core/**",
              "components/forms/**",
              "components/pipeline/**",
              "components/prose/**",
              "components/theme/**",
              "ui_kits/auteur-web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:EB Garamond|Archivo|IBM Plex Mono|Great Vibes))/i]",
        "message": "Font not provided by the design system. Available: EB Garamond, Archivo, IBM Plex Mono, Great Vibes."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|mono|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, mono, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|measured|edited|fail|cheap|balanced|strong)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'measured' | 'edited' | 'fail' | 'cheap' | 'balanced' | 'strong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|loading|fullWidth|href|type|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, loading, fullWidth, href, type, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|quiet|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'quiet' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:ground|padding|interactive|selected|accent|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: ground, padding, interactive, selected, accent, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='ground'] > Literal[value!=/^(?:ink|panel|paper|outline)$/]",
        "message": "<Card> ground must be one of 'ink' | 'panel' | 'paper' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Card> padding must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Exemplar'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|work|year|demonstrates|selected|onSelect|key|ref|className|style|children)$/]",
        "message": "<Exemplar> doesn't accept that prop. Declared props: text, work, year, demonstrates, selected, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|required|provenance|htmlFor|children|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, error, required, provenance, htmlFor, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='provenance'] > Literal[value!=/^(?:derived|edited)$/]",
        "message": "<Field> provenance must be one of 'derived' | 'edited'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|invalid|mono|icon|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: size, invalid, mono, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Input> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Markdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|ground|size|streaming|key|ref|className|style|children)$/]",
        "message": "<Markdown> doesn't accept that prop. Declared props: children, ground, size, streaming."
      },
      {
        "selector": "JSXOpeningElement[name.name='Markdown'] > JSXAttribute[name.name='ground'] > Literal[value!=/^(?:ink|paper)$/]",
        "message": "<Markdown> ground must be one of 'ink' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Markdown'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Markdown> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProsodyStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|band|target|status|key|ref|className|style|children)$/]",
        "message": "<ProsodyStat> doesn't accept that prop. Declared props: label, value, unit, band, target, status."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProsodyStat'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:neutral|pass|drift|fail)$/]",
        "message": "<ProsodyStat> status must be one of 'neutral' | 'pass' | 'drift' | 'fail'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProvenanceMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:origin|source|onReset|key|ref|className|style|children)$/]",
        "message": "<ProvenanceMark> doesn't accept that prop. Declared props: origin, source, onReset."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProvenanceMark'] > JSXAttribute[name.name='origin'] > Literal[value!=/^(?:measured|derived|edited)$/]",
        "message": "<ProvenanceMark> origin must be one of 'measured' | 'derived' | 'edited'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|size|invalid|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: options, size, invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Select> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:rows|invalid|prose|resize|counter|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: rows, invalid, prose, resize, counter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute[name.name='resize'] > Literal[value!=/^(?:none|vertical|both)$/]",
        "message": "<Textarea> resize must be one of 'none' | 'vertical' | 'both'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|onChange|size|showLabels|style|key|ref|className|style|children)$/]",
        "message": "<ThemeToggle> doesn't accept that prop. Declared props: mode, onChange, size, showLabels, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:auto|light|dark)$/]",
        "message": "<ThemeToggle> mode must be one of 'auto' | 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<ThemeToggle> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Thinking'] > JSXAttribute > JSXIdentifier[name!=/^(?:stage|tier|state|detail|elapsed|open|children|key|ref|className|style|children)$/]",
        "message": "<Thinking> doesn't accept that prop. Declared props: stage, tier, state, detail, elapsed, open, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Thinking'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:cheap|balanced|strong)$/]",
        "message": "<Thinking> tier must be one of 'cheap' | 'balanced' | 'strong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Thinking'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:pending|running|done|failed)$/]",
        "message": "<Thinking> state must be one of 'pending' | 'running' | 'done' | 'failed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WizardStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|note|key|ref|className|style|children)$/]",
        "message": "<WizardStep> doesn't accept that prop. Declared props: id, label, note."
      }
    ]
  },
